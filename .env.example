# Copy to .env and fill in locally. Never commit .env.
# See CLAUDE.md non-negotiable rules: default environment must always be demo,
# and live trading requires multiple explicit flags plus risk checks.

# TRADING / EXECUTION environment and live-trading safety gate. Per CLAUDE.md
# this must stay demo (or development); live order submission is impossible
# unless KALSHI_ENV=production plus the explicit flags below. This does NOT
# select where research data is read from -- that is KALSHI_DATA_ENV.
# development | demo | backtest | production
KALSHI_ENV=demo

# DATA-COLLECTION environment: which Kalshi API all research/archival reads use
# (discovery, snapshots, trades, order books, settlement, candlesticks,
# revision). Defaults to production -- only production has real liquidity;
# demo carries ~zero volume (ADR 0013/0014). Deliberately separate from
# KALSHI_ENV so the future demo execution client and the production data client
# can never be confused. Read-only public data needs no credentials.
# demo | production
KALSHI_DATA_ENV=production

# --- Database ---
DATABASE_URL=postgresql+psycopg://kalshi:kalshi@localhost:5432/kalshi_weather
# Dedicated forward paper-trading database -- NEVER the research database.
# Simulated fills are kept out of authoritative collected history by
# construction (separate database, separate metadata). SQLite file default;
# its directory is created on first use.
PAPER_DATABASE_URL=sqlite+aiosqlite:///data/paper/paper_trading.db

# --- Kalshi API ---
# Base URLs are also configurable in config/*.yaml; env vars here override for local dev.
KALSHI_PROD_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# Authenticated (demo) access only.
KALSHI_DEMO_API_KEY_ID=
# PREFERRED: the path to a local, gitignored PEM file (e.g.
# secrets/kalshi-demo.pem). Inline PEM text also works, but ONLY if the
# whole multi-line value is wrapped in double quotes -- an unquoted
# multi-line PEM silently truncates to its first line under python-dotenv
# and fails auth with MalformedFraming (root-caused 2026-07-21).
KALSHI_DEMO_PRIVATE_KEY=secrets/kalshi-demo.pem

# --- Live trading safety (production) ---
# ALL of these must be explicitly set for live order submission to even be
# possible. There is no live order-submission code implemented yet regardless.
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRM=false

# --- Logging ---
LOG_LEVEL=INFO

# --- Collector (see docs/runbooks/collector.md) ---
COLLECTOR_CATEGORY=Climate and Weather
COLLECTOR_MARKET_STATUS=open
COLLECTOR_INTERVAL_SECONDS=300
# Bounded lookback window (days) for a market's FIRST trade fetch, when no
# trade checkpoint is stored yet. Bounds the fetch instead of requesting a
# market's entire lifetime trade history (some markets have >100,000 trades).
INITIAL_TRADE_BOOTSTRAP_LOOKBACK_DAYS=30

# --- Operations (see docs/runbooks/operations.md) ---
# Proactive client-side request spacing, seconds.
KALSHI_MIN_REQUEST_INTERVAL_SECONDS=0.1
WEATHER_MIN_REQUEST_INTERVAL_SECONDS=0.1
# Reactive backoff for Kalshi 429/5xx: the client honors a server Retry-After
# header when present, else waits base*2^attempt capped at max, with +/- jitter
# to de-synchronise the concurrent loops sharing the production API. base>0,
# max>=base, jitter in [0,1] (validated at startup).
KALSHI_BACKOFF_BASE_SECONDS=0.5
KALSHI_BACKOFF_MAX_SECONDS=8.0
KALSHI_BACKOFF_JITTER=0.25
# `ops health` marks a collector stale after this many missed intervals.
OPS_STALE_AFTER_INTERVALS=3
# Forecast-cadence run-attempt analysis window (hours): a healed collector
# outage ages out of the cadence check once it leaves this window; the
# active-outage signal (newest run overdue NOW) is evaluated separately.
CADENCE_RUN_WINDOW_HOURS=72
# Settled-transition capture: per-cycle bound and recency window for
# re-checking recently-tracked tickers that left the open-market list
# before a final result-bearing snapshot was captured.
COLLECTOR_SETTLE_CHECK_LIMIT=25
COLLECTOR_SETTLE_CHECK_DAYS=7

# --- Monitoring & alerting (see docs/runbooks/monitoring_alerting.md) ---
# Transport `ops monitor` uses to deliver an alert on a WARNING/CRITICAL
# observatory status. "none" (default) disables delivery -- the monitor
# still runs, decides, and logs history; it just never calls out.
# telegram | none
ALERT_TRANSPORT=none
# Telegram bot API credentials (message @BotFather to create a bot and get
# a token; message your bot once, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# How often launchd runs `ops monitor`, in seconds (read by
# scripts/service/common.sh at install time, not by Settings -- changing
# this requires scripts/service/install.sh, not just restart.sh).
MONITOR_INTERVAL_SECONDS=900

# --- External uptime heartbeat / dead-man's-switch ---
# ALERT_TRANSPORT above runs ON this machine and cannot fire when the machine
# is powered off. HEARTBEAT_URL is the OFF-device complement: create a check
# on an external "alert me when the pings stop" service (healthchecks.io is
# free; Better Uptime / Cronitor also work), set its grace period a little
# above HEARTBEAT_INTERVAL_SECONDS, and paste its ping URL here. `ops heartbeat`
# pings it every HEARTBEAT_INTERVAL_SECONDS *only while the collector is
# healthy*; a power-off, wedge, or DB outage stops the pings and the external
# service alerts. Leave blank to disable (the launchd agent then no-ops).
# Treat the URL as a secret (anyone with it can suppress your outage alert).
HEARTBEAT_URL=
# Max age of the newest market_snapshot before the collector is treated as
# unhealthy and the ping is withheld. Keep it above the collector interval
# (COLLECTOR_INTERVAL_SECONDS, default 300) with margin so one slow cycle
# doesn't trip a false outage.
HEARTBEAT_STALE_AFTER_SECONDS=900
# How often launchd runs `ops heartbeat`, in seconds (read by
# scripts/service/common.sh at install time; requires install.sh to change).
HEARTBEAT_INTERVAL_SECONDS=300

# --- PostgreSQL backup & recovery (see docs/runbooks/backup_recovery.md) ---
# Database identity scripts/backup_postgres.sh dumps -- defaults match
# docker-compose.yml's hardcoded POSTGRES_USER/POSTGRES_DB; only change
# these if you also change docker-compose.yml.
BACKUP_DB_USER=kalshi
BACKUP_DB_NAME=kalshi_weather
# Local backup destination override (absolute path). Empty (default):
# derive <KALSHI_DATA_DIR>/backups/postgres as before. Set this to an
# INTERNAL-disk directory when the scheduled (launchd) backup cannot write
# the derived location -- macOS TCC denies launchd agents access to
# removable volumes, which fails every scheduled run silently. The S3
# off-machine copy is redundancy on top of the local backup, never a
# substitute for it.
#   BACKUP_LOCAL_DIR=/Users/<you>/Library/Application Support/kalshi-weather/backups/postgres
BACKUP_LOCAL_DIR=
# Once-daily local time launchd runs scripts/backup_postgres.sh (read by
# scripts/service/common.sh at install time -- changing this requires
# scripts/service/install.sh). Default 03:00 avoids Kalshi trading-hours
# activity and both NWS forecast-issuance windows.
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=0
# Off-machine copy destination -- filesystem | s3 | none. "none" (default):
# local backups only; the audit finding this system addresses stays
# PARTIALLY CLOSED, not CLOSED, until one of these is configured. NEVER
# point BACKUP_REMOTE_PATH at the same physical disk as KALSHI_DATA_DIR --
# that would not be genuine redundancy.
BACKUP_REMOTE_TYPE=none
# A DIFFERENT mounted volume/NAS path than KALSHI_DATA_DIR, e.g.
#   BACKUP_REMOTE_PATH=/Volumes/SomeOtherDrive/kalshi-weather-backups
BACKUP_REMOTE_PATH=
# S3-compatible destination. Requires the `aws` CLI installed and
# configured with ITS OWN credentials (environment, ~/.aws/credentials, an
# instance role) -- no AWS key/secret is ever stored in this file.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
# A local backup older than this many hours is a WARNING/CRITICAL
# observatory finding; the off-machine copy gets a more lenient window.
BACKUP_STALE_AFTER_HOURS=30
BACKUP_REMOTE_STALE_AFTER_HOURS=48
# Free-space thresholds (GB) on the local backup destination's filesystem.
BACKUP_DISK_WARNING_FREE_GB=20
BACKUP_DISK_CRITICAL_FREE_GB=5
# Retention (grandfather-father-son: daily/weekly/monthly tiers) is a
# fully tested, dry-run-capable CAPABILITY (`ops backup prune`) but does
# NOT run automatically by default -- scripts/backup_postgres.sh has
# always documented "pruning is a deliberate manual act," and that policy
# is preserved, not silently overridden. Set to true to opt in.
BACKUP_AUTO_PRUNE=false
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_WEEKS=8
BACKUP_RETENTION_MONTHLY_MONTHS=12

# --- Storage roots (see docs/runbooks/dataset.md) ---
# Single root for all file-based persistent data (dataset exports today).
# Point at an external drive to keep bulk data off the repo disk, e.g.
#   KALSHI_DATA_DIR=/Volumes/<external-drive>/kalshi-weather-data
# If set explicitly, the directory's parent must already exist (a missing
# external root usually means the drive isn't mounted -- the CLI fails early
# rather than silently writing to the wrong disk). Unset -> repo-local
# ./data, created on demand.
KALSHI_DATA_DIR=
# Where versioned Parquet datasets + manifests are written. Leave empty to
# derive KALSHI_DATA_DIR/datasets (recommended); set only for split layouts.
DATASET_ROOT=
# Live PostgreSQL data directory override for docker-compose (bind mount).
# Leave empty to keep the Docker named volume (recommended). NEVER point at
# an ExFAT/FAT32 drive -- see the warning in docker-compose.yml.
KALSHI_PG_DATA_DIR=
# Collector service log directory (see docs/runbooks/collector_service.md).
# Deliberately defaults to the INTERNAL disk (~/Library/Logs/kalshi-weather):
# if the external data drive is missing, the failure must still get logged.
KALSHI_LOG_DIR=
# Optional YAML file of manual settlement-mapping OVERRIDES (mappings are
# otherwise derived automatically by the settlement parser -- see
# docs/runbooks/settlement.md and config/dataset_market_map.example.yaml).
# Leave unset to use parser output alone.
DATASET_MARKET_MAP_PATH=

# --- Weather collector (see docs/runbooks/weather_collector.md) ---
# NWS asks API consumers to identify themselves; no credentials needed.
WEATHER_USER_AGENT=kalshi-weather-research (github.com/kalshi-weather-research)
WEATHER_BACKFILL_DAYS=30
WEATHER_INTERVAL_SECONDS=1800

# --- Price ingestion (see docs/runbooks/price_ingestion.md) ---
# 1-minute candles by default; sufficient for end-game opportunity-persistence
# research (H0007 readiness artifact). Retention is a MEASURED, rolling
# finding (~67 days as of 2026-07-21), not a documented API guarantee --
# re-verify periodically and adjust the buffer if it changes.
PRICE_CANDLE_RESOLUTION_MINUTES=1
PRICE_SYNC_LIMIT_PER_CYCLE=50
PRICE_SYNC_INTERVAL_SECONDS=1800
PRICE_OBSERVED_RETENTION_DAYS=67
PRICE_RETENTION_WARNING_BUFFER_DAYS=10

# --- Post-expiration settled-metadata revision (ADR 0011) ---
# Kalshi keeps revising volume/open_interest/result after publishing
# status="finalized"; the market's own expiration_time (~7 days after close)
# is when they stop. This bounded pass re-checks each settled market once
# past that point and appends a snapshot only if something actually changed.
REVISION_SYNC_LIMIT_PER_CYCLE=50
REVISION_SYNC_INTERVAL_SECONDS=3600
