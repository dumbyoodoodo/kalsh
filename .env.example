# Copy to .env and fill in locally. Never commit .env.
# See CLAUDE.md non-negotiable rules: default environment must always be demo,
# and live trading requires multiple explicit flags plus risk checks.

# development | demo | backtest | production
KALSHI_ENV=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://kalshi:kalshi@localhost:5432/kalshi_weather

# --- Kalshi API ---
# Base URLs are also configurable in config/*.yaml; env vars here override for local dev.
KALSHI_PROD_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# Authenticated (demo) access only.
KALSHI_DEMO_API_KEY_ID=
# Either paste the private key text directly (starts with -----BEGIN...-----),
# or put the path to a local, gitignored PEM file instead. Either works.
KALSHI_DEMO_PRIVATE_KEY=

# --- Live trading safety (production) ---
# ALL of these must be explicitly set for live order submission to even be
# possible. There is no live order-submission code implemented yet regardless.
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRM=false

# --- Logging ---
LOG_LEVEL=INFO

# --- Collector (see docs/runbooks/collector.md) ---
COLLECTOR_CATEGORY=Climate and Weather
COLLECTOR_MARKET_STATUS=open
COLLECTOR_INTERVAL_SECONDS=300
